{
	"name": "zod-commander",
	"version": "0.1.0",
	"description": "A TypeScript utility for building type-safe CLI commands using commander and zod.",
	"author": "Román Via-Dufresne Saus <roman910dev@gmail.com>(https://github.com/roman910dev)",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/roman910dev/zod-commander.git"
	},
	"keywords": [
		"commander",
		"zod",
		"cli",
		"typescript"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@types/node": "^22.16.3",
		"commander": "^14.0.3",
		"husky": "^9.1.7",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"vitest": "^4.1.4",
		"zod": "^4.3.6"
	},
	"packageManager": "pnpm@10.12.4+sha512.5ea8b0deed94ed68691c9bad4c955492705c5eeb8a87ef86bc62c74a26b037b08ff9570f108b2e4dbd1dd1a9186fea925e527f141c648e85af45631074680184",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/zod3/index.d.ts",
			"import": "./dist/zod3/index.js",
			"require": "./dist/zod3/index.cjs",
			"default": "./dist/zod3/index.js"
		},
		"./zod3": {
			"types": "./dist/zod3/index.d.ts",
			"import": "./dist/zod3/index.js",
			"require": "./dist/zod3/index.cjs",
			"default": "./dist/zod3/index.js"
		},
		"./zod4": {
			"types": "./dist/zod4/index.d.ts",
			"import": "./dist/zod4/index.js",
			"require": "./dist/zod4/index.cjs",
			"default": "./dist/zod4/index.js"
		}
	},
	"files": [
		"dist/"
	],
	"imports": {
		"#/*": "./src/*",
		"#tests/*": "./tests/*"
	},
	"scripts": {
		"build": "tsup",
		"check": "biome check .",
		"fix": "biome check . --write",
		"format": "biome format . --write",
		"full-check": "pnpm ts && pnpm check",
		"lint": "biome lint .",
		"ci": "biome ci --threads=4",
		"prepublishOnly": "npm run build",
		"prepare": "husky",
		"test": "vitest run",
		"ts": "tsc --noEmit"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"commander": ">=8 <15",
		"zod": ">=3.20.0 <5"
	},
	"type": "module"
}
