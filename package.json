{
	"name": "zod-commander",
	"version": "0.1.3",
	"description": "A TypeScript utility for building type-safe CLI commands using commander and zod.",
	"author": "Román Via-Dufresne Saus <roman910dev@gmail.com>(https://github.com/roman910dev)",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/roman910dev/zod-commander.git"
	},
	"keywords": [
		"commander",
		"zod",
		"cli",
		"typescript"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.5.3",
		"@types/node": "^24.13.3",
		"commander": "^15.0.0",
		"husky": "^9.1.7",
		"tsdown": "^0.22.4",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10",
		"zod": "^4.4.3"
	},
	"packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/zod4/index.d.mts",
			"import": "./dist/zod4/index.mjs",
			"require": "./dist/zod4/index.cjs",
			"default": "./dist/zod4/index.mjs"
		},
		"./zod3": {
			"types": "./dist/zod3/index.d.mts",
			"import": "./dist/zod3/index.mjs",
			"require": "./dist/zod3/index.cjs",
			"default": "./dist/zod3/index.mjs"
		},
		"./zod4": {
			"types": "./dist/zod4/index.d.mts",
			"import": "./dist/zod4/index.mjs",
			"require": "./dist/zod4/index.cjs",
			"default": "./dist/zod4/index.mjs"
		}
	},
	"files": [
		"dist/"
	],
	"imports": {
		"#/*": "./src/*",
		"#tests/*": "./tests/*"
	},
	"scripts": {
		"build": "tsdown",
		"check": "biome check .",
		"fix": "biome check . --write",
		"format": "biome format . --write",
		"full": "pnpm full-check && pnpm test",
		"full-check": "pnpm ts && pnpm check",
		"lint": "biome lint .",
		"ci": "biome ci --threads=4",
		"prepublishOnly": "npm run build",
		"prepare": "husky",
		"test": "vitest run",
		"ts": "tsc --noEmit"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"commander": ">=8 <16",
		"zod": ">=3.20.0 <5"
	},
	"type": "module"
}
